{
  "name": "felix-room-demo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^26.13.0",
    "pnpm": "12.16.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.13.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:rea": "vite preview --outDir ../rea",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --check src vite.config.js eslint.config.js",
    "format:fix": "prettier --write src vite.config.js eslint.config.js"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@types/three": "0.187.0",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "8.3.0"
  },
  "prettier": {
    "plugins": ["@ianvs/prettier-plugin-sort-imports"],
    "importOrder": ["<THIRD_PARTY_MODULES>", "", "^[.]"]
  }
}
